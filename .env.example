# Copy this file's contents into Vercel: Project Settings -> Environment Variables.
# Do NOT commit a real .env file with real values to GitHub.

# Required. Get this from https://console.anthropic.com -> API Keys.
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Optional but recommended. Anyone with your live URL can use the AI feature
# (and spend your API credits) unless this is set. Pick any passphrase; you'll
# share it with your team, and they'll be prompted for it once in the browser.
APP_PASSCODE=choose-a-team-passcode

# Optional. Defaults to claude-sonnet-5 if not set. Use claude-haiku-4-5-20251001
# for a cheaper/faster model if the extraction quality is good enough for your needs.
CLAUDE_MODEL=claude-sonnet-5
